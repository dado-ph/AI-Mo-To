{
  "schemaVersion": "1.0.0",
  "id": "task-list",
  "kind": "list",
  "title": "Tasks",
  "root": {
    "type": "list",
    "bind": "collections.task",
    "props": {
      "primary": "title",
      "secondary": "dueAt",
      "emptyMessage": "No tasks yet"
    },
    "children": [
      { "type": "status-badge", "bind": "status" },
      {
        "type": "action",
        "id": "complete",
        "label": "Complete",
        "command": "complete"
      }
    ]
  }
}
