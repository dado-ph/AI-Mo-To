{
  "schemaVersion": "1.0.0",
  "id": "task-form",
  "kind": "form",
  "title": "New task",
  "root": {
    "type": "form",
    "id": "new-task",
    "command": "create",
    "children": [
      { "type": "field", "id": "title", "label": "Title", "bind": "title" },
      { "type": "field", "id": "notes", "label": "Notes", "bind": "notes" },
      { "type": "field", "id": "dueAt", "label": "Due", "bind": "dueAt" },
      {
        "type": "action-bar",
        "children": [
          { "type": "action", "id": "save", "label": "Add task", "command": "create" }
        ]
      }
    ]
  }
}
