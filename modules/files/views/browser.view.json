{
  "schemaVersion": "1.0.0",
  "id": "browser",
  "kind": "table",
  "title": "Files",
  "root": {
    "type": "tabs",
    "children": [
      {
        "type": "table",
        "id": "files",
        "bind": "collections.file",
        "props": {
          "columns": ["name", "kind", "size", "updatedAt"],
          "emptyMessage": "No files in this workspace"
        }
      },
      {
        "type": "action-bar",
        "children": [
          {
            "type": "file-picker",
            "id": "open-file",
            "label": "Choose file",
            "props": { "mode": "workspace-relative" }
          }
        ]
      }
    ]
  }
}
