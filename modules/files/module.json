{
  "schemaVersion": "1.0.0",
  "moduleId": "aimoto.files",
  "name": "Files",
  "version": "0.1.0",
  "trustTier": "core",
  "collections": [
    {
      "id": "file",
      "schema": "schemas/file.schema.json",
      "key": "fileId",
      "indexes": ["name", "updatedAt"]
    }
  ],
  "views": [
    {
      "id": "browser",
      "kind": "table",
      "declaration": "views/browser.view.json"
    },
    {
      "id": "detail",
      "kind": "detail",
      "declaration": "views/detail.view.json"
    }
  ],
  "commands": [
    { "id": "register", "inputSchema": "schemas/file.schema.json" },
    { "id": "remove" }
  ],
  "events": [{ "id": "registered" }, { "id": "removed" }],
  "capabilities": ["workspace.files.read", "workspace.files.propose"],
  "migrations": []
}
