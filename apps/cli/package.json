{
  "name": "@ai-mo-to/cli",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "aimoto": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "aimoto": "node --disable-warning=ExperimentalWarning dist/bin.js"
  },
  "dependencies": {
    "@ai-mo-to/engine": "workspace:*",
    "@ai-mo-to/foundry": "workspace:*",
    "@ai-mo-to/protocol": "workspace:*"
  }
}
