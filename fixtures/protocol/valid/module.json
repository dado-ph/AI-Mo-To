{
  "schemaVersion": "1.0.0",
  "moduleId": "local.custom-tool",
  "name": "Custom Tool",
  "version": "0.1.0",
  "trustTier": "local-generated",
  "handler": {
    "runtime": "node",
    "entrypoint": "dist/handler.js"
  },
  "collections": [
    {
      "id": "items",
      "schema": {
        "type": "object",
        "required": ["itemId", "name"]
      }
    }
  ],
  "views": [
    {
      "id": "items-list",
      "kind": "list",
      "collection": "items"
    },
    {
      "id": "items-form",
      "kind": "form",
      "collection": "items"
    }
  ],
  "commands": [
    {
      "id": "create-item"
    }
  ],
  "events": [
    {
      "id": "item-created"
    }
  ],
  "capabilities": [
    "data.items.write"
  ],
  "migrations": []
}
