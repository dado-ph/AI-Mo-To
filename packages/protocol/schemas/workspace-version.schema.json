{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-mo-to.dev/schemas/v1/workspace-version.schema.json",
  "title": "AI-Mo-To Workspace Version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "versionId",
    "workspaceId",
    "revision",
    "createdAt",
    "message",
    "parentVersionId",
    "fileManifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "versionId": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "message": { "type": "string", "minLength": 1 },
    "parentVersionId": { "type": ["string", "null"], "minLength": 1 },
    "fileManifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
