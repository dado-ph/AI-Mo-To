{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-mo-to.dev/schemas/v1/approval-record.schema.json",
  "title": "AI-Mo-To Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvalId", "proposalId", "workspaceId", "baseRevision", "changeSetDigest", "approvedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "approvalId": { "type": "string", "format": "uuid" },
    "proposalId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "changeSetDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "approvedBy": { "type": "string", "minLength": 1 }
  }
}
