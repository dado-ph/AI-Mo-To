{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-mo-to.dev/schemas/v1/change-set.schema.json",
  "title": "AI-Mo-To ChangeSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeSetId",
    "workspaceId",
    "baseRevision",
    "createdAt",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "changeSetId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "kind",
          "input",
          "preconditions",
          "effects",
          "reversibility"
        ],
        "properties": {
          "operationId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "value": true
              }
            }
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "reversibility": {
            "enum": ["transactional", "reversible", "compensatable", "irreversible"]
          }
        }
      }
    }
  }
}

