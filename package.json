{
  "name": "ai-mo-to",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A local-first workspace foundry for modular, human-approved software.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build && node scripts/link-cli.mjs",
    "link:cli": "node scripts/link-cli.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r build",
    "test:acceptance-verifier": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/acceptance/Test-SemanticVerifier.ps1",
    "validate": "pnpm typecheck && pnpm test && pnpm test:acceptance-verifier"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
